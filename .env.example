# Copy to .env and adjust for your environment. See README.md "Environments".

# The web admin's origin. Local Docker Compose (Kong): http://localhost:8000
# Local `npm run dev` (vite, backend run natively): http://localhost:5173
WEB_BASE_URL=http://localhost:8000

# The REST API's base path, reached through the same origin as WEB_BASE_URL
# by default (Kong or the vite dev proxy both forward /api to the backend).
# Override only if the API lives at a different origin than the web admin.
API_BASE_URL=http://localhost:8000/api

# Mailpit's HTTP API (OTP codes, invitation links). Never point this at a
# real mail provider -- fixtures read and assert on message content.
MAILPIT_URL=http://localhost:8025

# The platform-admin SPA's origin. Kong routes it by host, not by path
# (ci/kong.yml: admin-web-route matches `admin.localhost`), so it cannot
# live under WEB_BASE_URL. `admin.localhost` resolves to 127.0.0.1 on
# systemd-resolved hosts (CI included); add it to /etc/hosts elsewhere.
ADMIN_WEB_BASE_URL=http://admin.localhost:8000

# Must match PLATFORM_ADMIN_EMAILS in ci/compose.yml (the dataset `admin`
# persona, 00_Test_Data.md §2). Used by the admin-web suite.
PLATFORM_ADMIN_EMAIL=admin@vietgara.test

# Shared password for every generated test user (00_Test_Data.md §1).
TEST_USER_PASSWORD=Qa@123456

# Which `environments` section of the pinned dataset the baseline seed reads
# passwords from. `stubbed` holds disposable test passwords in the dataset
# itself; staging holds only `passwordRef`s, so set TEST_USER_PASSWORD (and
# ADMIN_PASSWORD for the admin actor) from CI secrets instead.
SEED_ENV=stubbed

# The platform admin's password on the stubbed stack (dataset
# environments.stubbed.adminPassword). The suite uses it to approve plan
# payments (Release 5.2) and to sign in to the admin web.
PLATFORM_ADMIN_PASSWORD=Admin#2026-local

# Direct database access for the time-shifting helpers (the SQL helpers H1 to
# H4 of the scenarios' README, src/fixtures/timeshift.ts): E2E-LIC-010/011
# skip when it is empty. ci/compose.yml publishes Postgres on 127.0.0.1:${PG_PORT:-15432}.
DATABASE_URL=postgres://user:password@localhost:15432/vietgara
